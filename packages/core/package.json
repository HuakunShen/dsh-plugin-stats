{
  "name": "@dsh-stats/core",
  "version": "0.1.0",
  "description": "Portable stats core for DeepSeek Harness usage telemetry: zod schemas, sampling math, aggregation, JSONL store. Zero DSH dependencies \u2014 reusable by any project.",
  "license": "MIT",
  "private": true,
  "author": "Huakun Shen <huakun.shen@huakun.shen.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HuakunShen/dsh-plugin-stats.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/HuakunShen/dsh-plugin-stats/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/HuakunShen/dsh-plugin-stats/issues"
  },
  "keywords": [
    "deepseek-harness",
    "telemetry",
    "statistics",
    "tokens-per-second",
    "zod",
    "typescript"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas.ts",
    "./sampling": "./src/sampling.ts",
    "./aggregate": "./src/aggregate.ts",
    "./csv": "./src/csv.ts",
    "./store": "./src/store.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  }
}
