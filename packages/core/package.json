{
  "name": "@dsh-stats/core",
  "version": "0.1.0",
  "description": "Portable stats core for DeepSeek Harness usage telemetry: zod schemas, sampling math, aggregation, JSONL store. Zero DSH dependencies — reusable by any project.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./schemas": {
      "types": "./dist/schemas.d.mts",
      "default": "./dist/schemas.mjs"
    },
    "./sampling": {
      "types": "./dist/sampling.d.mts",
      "default": "./dist/sampling.mjs"
    },
    "./aggregate": {
      "types": "./dist/aggregate.d.mts",
      "default": "./dist/aggregate.mjs"
    },
    "./csv": {
      "types": "./dist/csv.d.mts",
      "default": "./dist/csv.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  }
}
