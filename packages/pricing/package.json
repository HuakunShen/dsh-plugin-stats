{
  "name": "@dsh-stats/pricing",
  "version": "0.1.0",
  "description": "Model price lookup and tokens-to-USD math with a bundled models.dev snapshot. Zero DSH dependencies — reusable by any project.",
  "license": "MIT",
  "author": "Huakun Shen <huakun.shen@huakun.shen.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HuakunShen/dsh-plugin-stats.git",
    "directory": "packages/pricing"
  },
  "homepage": "https://github.com/HuakunShen/dsh-plugin-stats/tree/main/packages/pricing#readme",
  "bugs": {
    "url": "https://github.com/HuakunShen/dsh-plugin-stats/issues"
  },
  "keywords": [
    "llm",
    "pricing",
    "cost",
    "models.dev",
    "tokens",
    "typescript"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
