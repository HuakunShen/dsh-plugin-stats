    {
      "dot": "cyan",
      "title": "Pipeline",
      "items": [
        "One sample per assistant step / tool call / lifecycle event, across all sessions",
        "Every payload zod-validated at the boundary — failures skip and count, never throw",
        "step/start marks step begins; measurability flags windows <250 ms or >maxPlausibleTps"
      ]
    },
    {
      "dot": "emerald",
      "title": "Store",
      "items": [
        "samples.jsonl: one JSON object per line — step · tool · session-join/leave",
        "Retention bounded two ways: 5 MB rotation to 75% + 30-day age sweep",
        "session/created + session/disposed markers are written directly by the host half"
      ]
    },
    {
      "dot": "violet",
      "title": "Consumers",
      "items": [
        "Panel fetches summary.json (aggregates) and samples.jsonl (chart points), both re-validated",
        "samples.csv serves step rows to spreadsheets and notebooks",
        "CLI recompute re-derives tps/cost under new rules — backs up first, plugin stopped"
